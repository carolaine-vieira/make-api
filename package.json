{
  "name": "my-vercel-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include \"api/**\" --include \"features/**\" --include \"shared/**\" dev-server.ts",
    "new": "tsx scripts/new-endpoint.ts",
    "build": "tsx scripts/generate-docs.ts",
    "start": "vercel dev",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"features/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vercel/node": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vercel": "^62.2.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.5"
  }
}
